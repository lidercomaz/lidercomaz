# Supabase (Project Settings → API). Without these the site reads .data/*.json (local dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: admin panel writes and the import scripts. Never expose to the browser (mark Sensitive on Vercel).
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin): login password, and the token bots send as "Authorization: Bearer <token>" (min. 24 chars).
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
# Optional: automatic AZ ↔ RU translation in the panel and for bots (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=

# Optional overrides (defaults: lider.com.az / ru.lider.com.az in production)
# NEXT_PUBLIC_SITE_URL_AZ=https://lider.com.az
# NEXT_PUBLIC_SITE_URL_RU=https://ru.lider.com.az
