# Supabase (Project Settings → API). Without these the site reads .data/*.json (local dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: admin panel writes and the import scripts. Never expose to the browser (mark Sensitive on Vercel).
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin): login e-mail + password, and the token bots send as "Authorization: Bearer <token>" (min. 24 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
# New pictures (panel, editor, news bot) are uploaded to imgbb (https://api.imgbb.com → Get API key).
IMGBB_API_KEY=
# Optional: automatic AZ ↔ RU translation in the panel and for bots (aistudio.google.com → Get API key).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional overrides (defaults: lider.com.az / ru.lider.com.az in production)
# NEXT_PUBLIC_SITE_URL_AZ=https://lider.com.az
# NEXT_PUBLIC_SITE_URL_RU=https://ru.lider.com.az
