# Supabase (Project Settings → API). Without these the site reads .data/*.json (local dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only for scripts/import-supabase.mjs — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults: lider.com.az / ru.lider.com.az in production)
# NEXT_PUBLIC_SITE_URL_AZ=https://lider.com.az
# NEXT_PUBLIC_SITE_URL_RU=https://ru.lider.com.az
